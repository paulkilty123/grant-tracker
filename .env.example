# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your
# Supabase project credentials from:
# https://supabase.com/dashboard → Project Settings → API
# ─────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Only needed server-side (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# MCP brand + origins (src/lib/mcp-brand.ts)
#
# All optional. Unset = current production values, so leaving this whole
# block out is a no-op. Set them to rebrand or move domain without a code
# change. A malformed value throws at startup rather than emitting broken
# URLs, so a typo fails the deploy instead of shipping quietly.
#
# Two origins because they genuinely differ today:
#   MCP_PUBLIC_ORIGIN  protocol surface — OAuth issuer/resource, serverInfo,
#                      WWW-Authenticate. Must be the host that serves bearer
#                      traffic directly; an apex→www redirect strips the
#                      Authorization header.
#   MCP_APP_ORIGIN     user-facing links — grant_tracker_url, attribution
#                      source_url, upgrade notes.
# Set both to the same value if the domain has no apex/www split.
# ─────────────────────────────────────────────

# MCP_PUBLIC_ORIGIN=https://www.granttracker.co.uk
# MCP_APP_ORIGIN=https://granttracker.co.uk
# MCP_BRAND_NAME=Grant Tracker
# MCP_SERVER_SLUG=grant-tracker-mcp
# MCP_CONTACT_EMAIL=hello@granttracker.co.uk

# Hosts that used to carry the MCP identity and should now 308 to
# MCP_PUBLIC_ORIGIN. Comma-separated, hosts or origins. Empty = no redirects.
# Set this at cutover, in the SAME change as MCP_PUBLIC_ORIGIN, so the old
# origin stops answering exactly when the new one starts. An explicit list, not
# "anything non-canonical", so Vercel previews and localhost are unaffected.
# The canonical host is ignored if listed, so a mistake cannot cause a loop.
# MCP_RETIRED_HOSTS=www.granttracker.co.uk,granttracker.co.uk
